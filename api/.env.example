# Copy to Vercel Environment Variables (both projects need GITHUB_TOKEN).
# Use different GITHUB_RESULTS_PATH per project.

GITHUB_TOKEN=
GITHUB_REPO=vkuperman/MoTR_spotlight
GITHUB_BRANCH=main

# mo-tr-spotlight-sona:
# GITHUB_RESULTS_PATH=run_motr_in_magpie/Results/spotlight_SONA

# mo-tr-spotlight-prolific:
# GITHUB_RESULTS_PATH=run_motr_in_magpie/Results/spotlight_PROLIFIC

# Optional email fallback:
# RESEND_API_KEY=
# EMAIL_TO=
