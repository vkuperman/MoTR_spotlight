# Upload results API – set these in Vercel (or your host) environment.
# At least one of (email) or (GitHub) must be set.

# Email via Resend
RESEND_API_KEY=
EMAIL_TO=

# Save zip to GitHub (optional; use alongside email to do both)
GITHUB_TOKEN=
GITHUB_REPO=vkuperman/MoTR_spotlight
GITHUB_RESULTS_PATH=run_motr_in_magpie/Results
GITHUB_BRANCH=main
